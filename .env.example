# Environment variables pour docker-compose
# ⚠️ NE PAS COMMITTER CE FICHIER AVEC DES VRAIES CREDENTIALS
# Copier ce fichier vers .env et adapter les valeurs

# Database
DB_USERNAME=skilltracker_user
DB_PASSWORD=change_me_in_production

# JWT
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_openssl_rand_base64_64
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# Swagger (false en production)
SWAGGER_ENABLED=false

# Java Options
JAVA_OPTS=-Xmx512m -Xms256m

